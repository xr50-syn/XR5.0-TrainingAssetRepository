# ===========================================
# .env.prod - Production Environment (S3)
# ===========================================

# Environment Type
ASPNETCORE_ENVIRONMENT=Production
STORAGE_TYPE=S3

# Database Configuration
XR50_REPO_DB_NAME=magical_library_prod
XR50_REPO_DB_USER=change_me
XR50_REPO_DB_PASSWORD=change_me

# S3 Configuration (Production Environment)
# IMPORTANT: Buckets must be pre-provisioned!
# The application does NOT create buckets automatically.
# Create buckets manually following the naming convention: {S3_BASE_BUCKET_PREFIX}-tenant-{tenant-name}
AWS_HOST=https://s3.example.com
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_REGION=eu-west-1

# S3 Settings
S3_BASE_BUCKET_PREFIX=xr50-prod
S3_FORCE_PATH_STYLE=true

# OwnCloud settings (not used in production)
OWNCLOUD_TRUSTED_DOMAINS=
OWNCLOUD_ADMIN_USER=
OWNCLOUD_ADMIN_PASSWORD=
OWNCLOUD_DB_USER=
OWNCLOUD_DB_PASSWORD=

# IAM/Keycloak Configuration (Production)
# Update these to match your production IAM provider
KEYCLOAK_AUTHORITY=https://your-keycloak.example.com/realms/xr50
KEYCLOAK_METADATA=https://your-keycloak.example.com/realms/xr50/.well-known/openid-configuration
KEYCLOAK_ISSUER=https://your-keycloak.example.com/realms/xr50
KEYCLOAK_AUDIENCE=xr50-training-api
KEYCLOAK_REQUIRE_HTTPS=true
IAM_ALLOW_ANONYMOUS=false

# XR5.0 Hub session token integration (secret provided by the Hub operator out of band).
# XR50HUB_DEV_TOKEN must stay empty in production; it is Development-only.
XR50HUB_BASE_URL=https://platform.xr50.eu
XR50HUB_SHARED_SECRET=change_me
XR50HUB_DEV_TOKEN=
# Create a local user row on a Hub identity's first request (roles are never granted
# automatically; the Hub token carries none). Set to false to require pre-provisioning.
XR50HUB_AUTO_PROVISION_USERS=true
