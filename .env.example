# Copy this file to .env for local development.
# Do not commit real .env files.

ASPNETCORE_ENVIRONMENT=Development
STORAGE_TYPE=S3

XR50_REPO_DB_NAME=magical_library
XR50_REPO_DB_USER=change_me
XR50_REPO_DB_PASSWORD=change_me

AWS_HOST=http://minio:10000
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_REGION=eu-west-1

S3_BASE_BUCKET_PREFIX=xr50-sandbox
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_ENDPOINT=http://localhost:10000

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me
KEYCLOAK_AUTHORITY=http://keycloak:8080/realms/xr50
KEYCLOAK_METADATA=http://keycloak:8080/realms/xr50/.well-known/openid-configuration
KEYCLOAK_ISSUER=http://localhost:8180/realms/xr50
KEYCLOAK_AUDIENCE=xr50-training-api
KEYCLOAK_REQUIRE_HTTPS=false
IAM_ALLOW_ANONYMOUS=false

# XR5.0 Hub session token integration (secret and dev token provided by the Hub operator
# out of band; dev token is honored only in the Development environment)
XR50HUB_BASE_URL=https://platform.xr50.eu
XR50HUB_SHARED_SECRET=change_me
XR50HUB_DEV_TOKEN=
# Create a local user row on a Hub identity's first request (roles are never granted
# automatically; the Hub token carries none). Set to false to require pre-provisioning.
XR50HUB_AUTO_PROVISION_USERS=true

CHATBOT_API_BASE_URL=https://datalens.example.com
CHATBOT_API_BEARER_TOKEN=change_me
