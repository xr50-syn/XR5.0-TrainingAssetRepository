# ===========================================
# .env.lab - Lab Environment (OwnCloud)
# ===========================================

# Environment Type
ASPNETCORE_ENVIRONMENT=Development
STORAGE_TYPE=OwnCloud

# Database Configuration
XR50_REPO_DB_NAME=magical_library
XR50_REPO_DB_USER=change_me
XR50_REPO_DB_PASSWORD=change_me

# Schema migrations (applied at startup by default; see docs/architecture.md "Database Migrations")
DB_MIGRATE_ON_STARTUP=true
DB_TOLERATE_TENANT_MIGRATION_FAILURES=false

# OwnCloud Configuration (Lab Environment)
OWNCLOUD_TRUSTED_DOMAINS=localhost,owncloud,127.0.0.1
OWNCLOUD_ADMIN_USER=admin
OWNCLOUD_ADMIN_PASSWORD=change_me
OWNCLOUD_DB_USER=owncloud
OWNCLOUD_DB_PASSWORD=change_me

# OwnCloud API Paths
OWNCLOUD_BASE_API=http://owncloud:8080
OWNCLOUD_BASE_WEBDAV=http://owncloud:8080/remote.php/webdav
OWNCLOUD_GROUPS_PATH=/ocs/v1.php/cloud/groups
OWNCLOUD_USERS_PATH=/ocs/v1.php/cloud/users

# S3 settings (not used in lab but keeping for completeness)
AWS_HOST=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# IAM/Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me
KEYCLOAK_AUTHORITY=http://keycloak:8080/realms/xr50
KEYCLOAK_METADATA=http://keycloak:8080/realms/xr50/.well-known/openid-configuration
KEYCLOAK_ISSUER=http://localhost:8180/realms/xr50
KEYCLOAK_AUDIENCE=xr50-training-api
KEYCLOAK_REQUIRE_HTTPS=false
IAM_ALLOW_ANONYMOUS=false

# XR5.0 Hub session token integration (secret and dev token provided by the Hub operator
# out of band; dev token is honored only in the Development environment)
XR50HUB_BASE_URL=https://platform.xr50.eu
XR50HUB_SHARED_SECRET=change_me
XR50HUB_DEV_TOKEN=
# Create a local user row on a Hub identity's first request (roles are never granted
# automatically; the Hub token carries none). Set to false to require pre-provisioning.
XR50HUB_AUTO_PROVISION_USERS=true
