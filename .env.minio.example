# ===========================================
# .env.minio - Local MinIO Testing
# ===========================================

# Environment Type
ASPNETCORE_ENVIRONMENT=Development
STORAGE_TYPE=S3

# Database Configuration
XR50_REPO_DB_NAME=magical_library
XR50_REPO_DB_USER=change_me
XR50_REPO_DB_PASSWORD=change_me

# Schema migrations (applied at startup by default; see docs/architecture.md "Database Migrations")
DB_MIGRATE_ON_STARTUP=true
DB_TOLERATE_TENANT_MIGRATION_FAILURES=false

# MinIO S3 Configuration (Local Testing)
AWS_HOST=http://minio:10000
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_REGION=us-east-1

# S3 Settings for MinIO
S3_BASE_BUCKET_PREFIX=xr50-test
S3_FORCE_PATH_STYLE=true

# Public Endpoint (URL returned to clients for file access)
# For local testing, use localhost
S3_PUBLIC_ENDPOINT=http://localhost:10000

# MinIO Settings
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
